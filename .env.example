# Konfigurasi Server & Environment
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Konfigurasi Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_bedengan
DB_CONNECTION_LIMIT=10

# Keamanan & Autentikasi JWT
JWT_SECRET=your_secret_here
JWT_EXPIRES_IN=7d

# Akun Default Seeder Admin
ADMIN_DEFAULT_NAME=Admin Bedengan
ADMIN_DEFAULT_EMAIL=admin@bedengan.com
ADMIN_DEFAULT_PASSWORD=your_admin_password_here

# Integrasi Google Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Integrasi Penyimpanan Cloud (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
CLOUDINARY_URL=

# Konfigurasi Upload File
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
